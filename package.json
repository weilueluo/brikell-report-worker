{
  "name": "@brikell/report-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --import tsx src/index.ts",
    "start:e2e-fixture": "node --env-file-if-exists=.env.local --import tsx scripts/start-worker-with-fixture.ts",
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "node scripts/run-tests.mjs e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@brikell/shared": "workspace:*",
    "@supabase/supabase-js": "^2.105.1",
    "marked": "^18.0.3",
    "pdfkit": "^0.18.0",
    "undici": "^8.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pdfkit": "^0.17.6",
    "cross-env": "^10.1.0",
    "pdfjs-dist": "^5.7.284",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
